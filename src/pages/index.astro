---
import Layout from '../layouts/Layout.astro';
import Calendar from '../components/Calendar.astro';
---

<Layout title="Volunteer">
  <div class="page-head">
    <div class="wrap">
      <h1>Kaiwi Coast</h1>
      <p class="lede">
        Volunteer events from every group caring for the coast. Pick an event and sign up.
      </p>
    </div>
  </div>
  <main>
    <section>
      <div class="wrap">
        <Calendar />
      </div>
    </section>
  </main>
</Layout>
